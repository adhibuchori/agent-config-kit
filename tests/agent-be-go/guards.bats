#!/usr/bin/env bats
# The two guards as a be-go repo configures them (.claude/agent-config.json from the template):
# generated-guard on the generated server, the sqlc output and the exported contract; migration-guard
# in append-only mode on db/migrations. Each rule is proven both ways.

load helpers

setup() {
  go_setup_env
  make_project
  mkdir -p "$PROJ/.claude" "$PROJ/internal/httpapi" "$PROJ/internal/postgres/db" "$PROJ/api"
  cp "$TPL/.claude/agent-config.json" "$PROJ/.claude/agent-config.json"
  cp "$TPL/internal/httpapi/api.gen.go" "$TPL/internal/httpapi/handlers.go" "$PROJ/internal/httpapi/"
  cp "$TPL/api/openapi.yaml" "$TPL/api/openapi.json" "$PROJ/api/"
  printf '// Code generated by sqlc. DO NOT EDIT.\n\npackage db\n' >"$PROJ/internal/postgres/db/db.go"
  git -C "$PROJ" add -A
  git -C "$PROJ" commit -q -m "set up"
}

@test "generated-guard: the generated server, sqlc's output and the exported contract are refused" {
  local f
  for f in internal/httpapi/api.gen.go internal/postgres/db/db.go api/openapi.json; do
    run_hook "$GENERATED_GUARD" "$(edit_payload Edit "$PROJ/$f")"
    [ "$status" -eq 2 ]
    [[ "$stderr" == *"[generated-guard] BLOCKED: $f"* ]] || false
  done
}

@test "generated-guard: the spec, the handlers and new code are free to edit" {
  local f
  for f in api/openapi.yaml internal/httpapi/handlers.go internal/billing/service.go; do
    run_hook "$GENERATED_GUARD" "$(edit_payload Write "$PROJ/$f")"
    [ "$status" -eq 0 ]
    [ -z "$stderr" ]
  done
}

@test "the guards stay silent in a project that has not opted in" {
  rm "$PROJ/.claude/agent-config.json"
  run_hook "$GENERATED_GUARD" "$(edit_payload Edit "$PROJ/internal/httpapi/api.gen.go")" \
    CLAUDE_PLUGIN_ROOT="$PLUGIN" CLAUDE_PLUGIN_DATA="$BATS_TEST_TMPDIR/data"
  [ "$status" -eq 0 ]
  run_hook "$MIGRATION_GUARD" "$(edit_payload Edit "$PROJ/db/migrations/00001_create_things.sql")" \
    CLAUDE_PLUGIN_ROOT="$PLUGIN" CLAUDE_PLUGIN_DATA="$BATS_TEST_TMPDIR/data"
  [ "$status" -eq 0 ]
}

@test "migration-guard: a migration main already has is refused; a new migration file is free" {
  grep -q 'appendOnlyMigrationsDirs' "$PLUGIN/scripts/lib.sh" ||
    skip "this checkout's shared lib.sh predates appendOnlyMigrationsDirs (agent-core's append-only mode)"
  run_hook "$MIGRATION_GUARD" "$(edit_payload Edit "$PROJ/db/migrations/00001_create_things.sql")"
  [ "$status" -eq 2 ]
  [[ "$stderr" == *"[migration-guard] BLOCKED: db/migrations/00001_create_things.sql"* ]] || false
  run_hook "$MIGRATION_GUARD" "$(edit_payload Write "$PROJ/db/migrations/00002_add_owner.sql")"
  [ "$status" -eq 0 ]
  [ -z "$stderr" ]
}

@test "migration-guard: a migration that exists only on a work branch is free to fix" {
  grep -q 'appendOnlyMigrationsDirs' "$PLUGIN/scripts/lib.sh" ||
    skip "this checkout's shared lib.sh predates appendOnlyMigrationsDirs (agent-core's append-only mode)"
  git -C "$PROJ" checkout -q -b work
  printf -- '-- +goose Up\nSELECT 1;\n' >"$PROJ/db/migrations/00002_add_owner.sql"
  git -C "$PROJ" add -A
  git -C "$PROJ" commit -q -m "work"
  run_hook "$MIGRATION_GUARD" "$(edit_payload Edit "$PROJ/db/migrations/00002_add_owner.sql")"
  [ "$status" -eq 0 ]
}

@test "migration-guard: without append-only support it leaves db/migrations alone rather than refusing new files" {
  grep -q 'appendOnlyMigrationsDirs' "$PLUGIN/scripts/lib.sh" && skip "append-only mode is present; the probes above cover it"
  run_hook "$MIGRATION_GUARD" "$(edit_payload Write "$PROJ/db/migrations/00002_add_owner.sql")"
  [ "$status" -eq 0 ]
}
