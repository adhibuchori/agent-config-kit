#!/usr/bin/env bats
# The gate scripts setup installs, each proven both ways on a toy repo: what it must fail, what it
# must pass, and the "nothing was checked" case it must not report as clean. The Go tools are stubs
# on PATH, so no test needs Go, golangci-lint or a database; the fixture run in the plugin's own
# verification exercises the real ones.

load helpers

setup() {
  go_setup_env
  REPO="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$REPO/scripts/check"
  git -C "$REPO" init -q
  REPO="$(cd "$REPO" && pwd -P)"
  STUBS="$BATS_TEST_TMPDIR/stubs"
  mkdir -p "$STUBS"
  export PATH="$STUBS:$PATH"
}

commit_all() {
  git -C "$REPO" add -A
  git -C "$REPO" commit -q -m "${1:-change}"
}

# ── endpoints.sh ────────────────────────────────────────────────────────────────────────────────

@test "endpoints: a route literal in hand-written Go fails and is named" {
  install_scripts scripts/check/endpoints.sh
  mkdir -p "$REPO/internal/billing"
  printf 'package billing\n\nconst invoices = "/api/invoices"\n' >"$REPO/internal/billing/routes.go"
  run --separate-stderr bash "$REPO/scripts/check/endpoints.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"internal/billing/routes.go:3:"* ]] || false
  [[ "$stderr" == *"Declare the operation in api/openapi.yaml"* ]] || false
}

@test "endpoints: a raw-string route literal fails too" {
  install_scripts scripts/check/endpoints.sh
  mkdir -p "$REPO/internal/billing"
  printf 'package billing\n\nconst invoices = `/api/invoices`\n' >"$REPO/internal/billing/routes.go"
  run --separate-stderr bash "$REPO/scripts/check/endpoints.sh"
  [ "$status" -eq 1 ]
}

@test "endpoints: the same literal in generated code or a test passes" {
  install_scripts scripts/check/endpoints.sh
  mkdir -p "$REPO/internal/httpapi"
  printf '// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst p = "/api/invoices"\n' \
    >"$REPO/internal/httpapi/api.gen.go"
  printf 'package httpapi\n\nconst target = "/api/invoices"\n' >"$REPO/internal/httpapi/router_test.go"
  printf 'package httpapi\n\nconst header = "X-Request-Id"\n' >"$REPO/internal/httpapi/middleware.go"
  run --separate-stderr bash "$REPO/scripts/check/endpoints.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *"1 hand-written Go file(s), no route literal"* ]] || false
}

@test "endpoints: a repo with no hand-written Go is not a pass" {
  install_scripts scripts/check/endpoints.sh
  run --separate-stderr bash "$REPO/scripts/check/endpoints.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"the check read nothing"* ]] || false
}

# ── migrations.sh (go stubbed: `go tool goose ... validate` succeeds) ─────────────────────────

migrations_repo() {
  install_scripts scripts/check/migrations.sh
  stub_bin go 'exit 0'
  mkdir -p "$REPO/db/migrations"
  cp "$FIXTURES/service/db/migrations/00001_create_things.sql" "$REPO/db/migrations/"
  printf -- '-- +goose Up\nCREATE TABLE owners (id bigint PRIMARY KEY);\n' >"$REPO/db/migrations/00002_create_owners.sql"
  commit_all init
}

@test "migrations: a new file above the base's newest version passes" {
  migrations_repo
  printf -- '-- +goose Up\nALTER TABLE things ADD COLUMN note text;\n' >"$REPO/db/migrations/00003_add_note.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *"compared with main: 1 new file(s)"* ]] || false
  [[ "$output" == *"3 file(s) checked"* ]] || false
}

@test "migrations: a changed, a deleted and a renamed migration of the base each fail" {
  migrations_repo
  printf -- '-- edited\n' >>"$REPO/db/migrations/00001_create_things.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00001_create_things.sql: changed; a migration on main never changes"* ]] || false
  git -C "$REPO" checkout -q -- db/migrations
  rm "$REPO/db/migrations/00002_create_owners.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00002_create_owners.sql: deleted"* ]] || false
  git -C "$REPO" checkout -q -- db/migrations
  git -C "$REPO" mv db/migrations/00002_create_owners.sql db/migrations/00002_create_owners_table.sql
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00002_create_owners.sql: renamed to db/migrations/00002_create_owners_table.sql"* ]] || false
}

@test "migrations: a new file at or below the base's newest version fails, as goose would refuse it" {
  migrations_repo
  git -C "$REPO" checkout -q -b work
  printf -- '-- +goose Up\nSELECT 1;\n' >"$REPO/db/migrations/00002_late.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00002_late.sql: version 00002 is not above 2"* ]] || false
  [[ "$output" == *"version 00002 is used twice"* ]] || false
}

@test "migrations: CREATE INDEX CONCURRENTLY needs a NO TRANSACTION file" {
  migrations_repo
  printf -- '-- +goose Up\nCREATE INDEX CONCURRENTLY things_name_idx ON things (name);\n' \
    >"$REPO/db/migrations/00003_things_name_idx.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"CONCURRENTLY cannot run in a transaction"* ]] || false
  printf -- '-- +goose NO TRANSACTION\n-- +goose Up\nCREATE INDEX CONCURRENTLY things_name_idx ON things (name);\n' \
    >"$REPO/db/migrations/00003_things_name_idx.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 0 ]
}

@test "migrations: a file not named <version>_<name>.sql fails" {
  migrations_repo
  printf 'package migrations\n' >"$REPO/db/migrations/00003_backfill.go"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00003_backfill.go: name it <version>_<snake_case_name>.sql"* ]] || false
}

@test "migrations: what goose validate refuses fails the gate" {
  migrations_repo
  stub_bin go 'echo "goose: duplicate version" >&2; exit 1'
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"goose validate refused the folder"* ]] || false
}

@test "migrations: no db/migrations, or an empty one, passes and says why" {
  install_scripts scripts/check/migrations.sh
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *"no db/migrations yet"* ]] || false
  mkdir -p "$REPO/db/migrations"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *"db/migrations is empty"* ]] || false
}

# ── generated.sh (go stubbed: `go generate` writes the server file) ──────────────────────────

# generated_repo <what the stubbed generator writes>: a repo with one committed generated file.
generated_repo() {
  install_scripts scripts/check/generated.sh
  mkdir -p "$REPO/internal/httpapi"
  printf '// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst v = 1\n' >"$REPO/internal/httpapi/api.gen.go"
  commit_all init
  # shellcheck disable=SC2016 # the stub's own variables
  stub_bin go '[ "$1" = generate ] || exit 0
printf "%s" "'"$1"'" >internal/httpapi/api.gen.go'
}

@test "generated: an output that matches its generator passes, read-only" {
  generated_repo $'// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst v = 1\n'
  run --separate-stderr bash "$REPO/scripts/check/generated.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *"1 generated file(s) match their generators"* ]] || false
  [[ "$output" == *"no SQL in db/queries yet"* ]] || false
  run git -C "$REPO" status --porcelain
  [ -z "$output" ]
}

@test "generated: an output its generator would now write differently fails, and the repo is untouched" {
  generated_repo $'// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst v = 2\n'
  run --separate-stderr bash "$REPO/scripts/check/generated.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"internal/httpapi/api.gen.go differs from what its generator writes now"* ]] || false
  [[ "$stderr" == *"generated.sh --write"* ]] || false
  grep -q 'const v = 1' "$REPO/internal/httpapi/api.gen.go"
}

@test "generated: --write regenerates in place" {
  generated_repo $'// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst v = 2\n'
  run --separate-stderr bash "$REPO/scripts/check/generated.sh" --write
  [ "$status" -eq 0 ]
  grep -q 'const v = 2' "$REPO/internal/httpapi/api.gen.go"
}

@test "generated: SELECT * in a query file fails" {
  generated_repo $'// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n\nconst v = 1\n'
  mkdir -p "$REPO/db/queries"
  printf -- '-- name: ListThings :many\nSELECT * FROM things ORDER BY id LIMIT $1;\n' >"$REPO/db/queries/things.sql"
  run --separate-stderr bash "$REPO/scripts/check/generated.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"name the columns"* ]] || false
  printf -- '-- name: ListThings :many\nSELECT id, name, count(*) OVER () FROM things ORDER BY id LIMIT $1;\n' \
    >"$REPO/db/queries/things.sql"
  run --separate-stderr bash "$REPO/scripts/check/generated.sh"
  [ "$status" -eq 0 ]
}

# ── lint.sh (golangci-lint stubbed) ─────────────────────────────────────────────────────────────

@test "lint: another golangci-lint version than tools.env pins fails before linting" {
  install_scripts scripts/check/lint.sh scripts/check/tools.env
  stub_bin golangci-lint '[ "$1" = version ] && { echo 2.13.0; exit 0; }; echo linted; exit 0'
  run --separate-stderr bash "$REPO/scripts/check/lint.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"this repo pins v2.14.0"* ]] || false
}

@test "lint: a stale exclusion rule fails although golangci-lint exits 0; a clean run passes" {
  install_scripts scripts/check/lint.sh scripts/check/tools.env
  stub_bin golangci-lint '[ "$1" = version ] && { echo 2.14.0; exit 0; }
echo "level=warning msg=\"[runner/exclusion_rules] Skipped 0 issues by rules: [Path: \\\"^cmd/api/\\\"]\""; echo "0 issues."'
  run --separate-stderr bash "$REPO/scripts/check/lint.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"excludes nothing any more"* ]] || false
  stub_bin golangci-lint '[ "$1" = version ] && { echo 2.14.0; exit 0; }; echo "0 issues."'
  run --separate-stderr bash "$REPO/scripts/check/lint.sh"
  [ "$status" -eq 0 ]
}

@test "lint: a finding fails with golangci-lint's own exit code" {
  install_scripts scripts/check/lint.sh scripts/check/tools.env
  stub_bin golangci-lint '[ "$1" = version ] && { echo 2.14.0; exit 0; }
echo "internal/x/a.go:202: file-length-limit: file length is 201 lines, which exceeds the limit of 200 (revive)"; exit 1'
  run --separate-stderr bash "$REPO/scripts/check/lint.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *"exceeds the limit of 200"* ]] || false
}

# ── coverage.sh, coverage-per-file.mjs, pooler.sh ───────────────────────────────────────────────

@test "coverage: without TEST_DATABASE_URL it fails and says how to run it" {
  install_scripts scripts/check/coverage.sh
  run --separate-stderr bash "$REPO/scripts/check/coverage.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"Run the tests through scripts/check/ci-env.sh"* ]] || false
}

# per_file_repo: go.mod, a generated file, a hand-written file, and a raw profile measuring both.
per_file_repo() {
  install_scripts scripts/check/coverage-per-file.mjs
  printf 'module example.com/service\n\ngo 1.27.0\n' >"$REPO/go.mod"
  mkdir -p "$REPO/internal/httpapi" "$REPO/internal/billing" "$REPO/coverage"
  printf '// Code generated by oapi-codegen DO NOT EDIT.\npackage httpapi\n' >"$REPO/internal/httpapi/api.gen.go"
  printf 'package billing\n' >"$REPO/internal/billing/service.go"
  printf 'mode: atomic\n%s\n%s\n%s\n' \
    'example.com/service/internal/httpapi/api.gen.go:3.1,5.2 4 0' \
    'example.com/service/internal/billing/service.go:3.1,5.2 2 1' \
    'example.com/service/internal/billing/service.go:6.1,8.2 1 0' >"$REPO/coverage/raw.out"
}

@test "coverage-per-file: generated files are left out by their header; an uncovered statement fails" {
  per_file_repo
  run --separate-stderr node "$REPO/scripts/check/coverage-per-file.mjs" filter-go "$REPO/coverage/raw.out" "$REPO/coverage/coverage.out"
  [ "$status" -eq 0 ]
  run ! grep -q 'api.gen.go' "$REPO/coverage/coverage.out"
  run --separate-stderr node "$REPO/scripts/check/coverage-per-file.mjs" check "$REPO/coverage/coverage.out"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"internal/billing/service.go: statements 2/3"* ]] || false
}

@test "coverage-per-file: an exemption with its reason drops the file; one without a reason is refused" {
  per_file_repo
  printf 'internal/billing/service.go  # composition root\n' >"$REPO/scripts/check/coverage-exempt.txt"
  run --separate-stderr node "$REPO/scripts/check/coverage-per-file.mjs" filter-go "$REPO/coverage/raw.out" "$REPO/coverage/coverage.out"
  [ "$status" -eq 0 ]
  run --separate-stderr node "$REPO/scripts/check/coverage-per-file.mjs" check "$REPO/coverage/coverage.out"
  [ "$status" -eq 2 ]
  [[ "$stderr" == *"measured no file"* ]] || false
  printf 'internal/billing/service.go\n' >"$REPO/scripts/check/coverage-exempt.txt"
  run --separate-stderr node "$REPO/scripts/check/coverage-per-file.mjs" filter-go "$REPO/coverage/raw.out" "$REPO/coverage/coverage.out"
  [ "$status" -eq 2 ]
  [[ "$stderr" == *'has no "# reason"'* ]] || false
}

@test "the template's exemption list names only the composition roots, each with a reason" {
  run grep -vE '^[[:space:]]*(#|$)' "$TPL/scripts/check/coverage-exempt.txt"
  [ "$output" = "cmd/*/main.go  # composition root: main only wires packages that have their own tests" ]
}

@test "pooler: without both database addresses it fails before running a test" {
  install_scripts scripts/check/pooler.sh
  stub_bin go 'echo "go must not run" >&2; exit 3'
  run --separate-stderr env TEST_MIGRATIONS_URL=postgres://app_owner@127.0.0.1:5432/app_test \
    TEST_DATABASE_URL=postgres://app_rw@127.0.0.1:5432/app_test bash "$REPO/scripts/check/pooler.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"TEST_POOLER_DATABASE_URL is not set"* ]] || false
  stub_bin go 'echo "$*"'
  run --separate-stderr env TEST_MIGRATIONS_URL=w TEST_DATABASE_URL=x TEST_POOLER_DATABASE_URL=y bash "$REPO/scripts/check/pooler.sh"
  [ "$status" -eq 0 ]
  [ "$output" = "test -race -count=1 -tags pooler -run ^TestPooler ./internal/postgres/" ]
}

# ── the payload registry gate line ──────────────────────────────────────────────────────────────

# payload_gate: the gates.list line of the payload registry check, run as gates.sh runs it.
payload_gate() {
  local cmd
  cmd="$(grep -E $'^code\t.*payload-registry\\.mjs' "$TPL/scripts/check/gates.list" | cut -f2-)"
  [ -n "$cmd" ]
  run --separate-stderr bash -c "cd \"$REPO\" && $cmd"
}

@test "payload gate: a repo that never adopted the contract passes, and says so" {
  command -v node >/dev/null || skip "node is not installed"
  install_scripts scripts/check/payload-registry.mjs scripts/lib/payload-registry.mjs
  payload_gate
  [ "$status" -eq 0 ]
}

@test "payload gate: an adopted repo runs the check, and fails when the check is missing or fails" {
  command -v node >/dev/null || skip "node is not installed"
  jq '.encryption = "off"' "$TPL/payload.config.json" >"$REPO/payload.config.json"
  payload_gate
  [ "$status" -ne 0 ]
  install_scripts scripts/check/payload-registry.mjs scripts/lib/payload-registry.mjs
  payload_gate
  [ "$status" -eq 1 ]
  [[ "$output$stderr" == *'payload.config.json says "off"'* ]] || false
}
