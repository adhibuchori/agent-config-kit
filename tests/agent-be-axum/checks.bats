#!/usr/bin/env bats
# The gate scripts setup installs, each proven both ways on a toy repo: what it must fail and what
# it must pass. rust-source.mjs needs only node; rustfmt.sh, coverage.sh and pooler.sh get a cargo
# stub, so no Rust toolchain is needed here (the fixture run proves them with the real one).

# shellcheck disable=SC2016 # Rust and SQL text, quoted as written
load helpers

setup() {
  ax_setup_env
  command -v node >/dev/null || skip "node not installed"
  make_repo
  install scripts/check/rust-source.mjs
}

# ── rust-source.mjs: LINES ──────────────────────────────────────────────────────────────────────

@test "LINES: the 30-line vector counts 20 lines of code" {
  run -0 node "$TPL/scripts/check/rust-source.mjs" --count "$FIXTURES/lines/vector.rs"
  [ "${output%%$'\t'*}" = 20 ]
}

@test "LINES: 201 lines of code fail, naming the 201st line" {
  local i
  {
    for i in $(seq 1 201); do printf 'const C%d: u8 = 0;\n' "$i"; done
  } >"$BATS_TEST_TMPDIR/long.rs"
  mkdir -p "$REPO/src/things" && cp "$BATS_TEST_TMPDIR/long.rs" "$REPO/src/things/model.rs"
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/things/model.rs:201: [LINES] 201 lines of code, over 200"* ]] || false
}

@test "LINES: 200 lines of code with 50 comment lines and blanks pass" {
  local i
  {
    for i in $(seq 1 50); do printf '// comment %d\n\n' "$i"; done
    for i in $(seq 1 200); do printf 'const C%d: u8 = 0;\n' "$i"; done
  } >"$BATS_TEST_TMPDIR/ok.rs"
  mkdir -p "$REPO/src/things" && cp "$BATS_TEST_TMPDIR/ok.rs" "$REPO/src/things/model.rs"
  source_check
  [ "$status" -eq 0 ]
  [[ "$output" == *"LINES HANDLERS ROUTES LAYERS SQL ALLOW clean"* ]] || false
}

@test "LINES: a file marked @generated is left out" {
  local i
  {
    printf '// @generated by a tool\n'
    for i in $(seq 1 201); do printf 'const C%d: u8 = 0;\n' "$i"; done
  } >"$REPO/src.rs"
  source_check
  [ "$status" -eq 0 ]
}

# ── HANDLERS ────────────────────────────────────────────────────────────────────────────────────

# handler <lines>: a #[utoipa::path] handler whose body holds that many lines of code.
handler() {
  local i
  {
    printf '#[utoipa::path(get, path = paths::THINGS)]\nasync fn list_things() -> u32 {\n'
    for i in $(seq 1 $(($1 - 1))); do printf '    let a%d = %d;\n' "$i" "$i"; done
    printf '    0\n}\n'
  } >"$REPO/src/routes/things.rs"
}

@test "HANDLERS: a handler body of 16 lines fails" {
  mkdir -p "$REPO/src/routes"
  handler 16
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/routes/things.rs:2: [HANDLERS] handler list_things has 16 lines of code in its body, over 15"* ]] || false
}

@test "HANDLERS: a handler body of 15 lines passes" {
  mkdir -p "$REPO/src/routes"
  handler 15
  source_check
  [ "$status" -eq 0 ]
}

# ── ROUTES ──────────────────────────────────────────────────────────────────────────────────────

@test "ROUTES: a path literal outside src/routes/paths.rs fails, and inside it passes" {
  rs src/routes/things.rs 'const X: &str = "/api/x";'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *'src/routes/things.rs:1: [ROUTES] path literal "/api/x" outside src/routes/paths.rs'* ]] || false
  rm "$REPO/src/routes/things.rs"
  rs src/routes/paths.rs 'pub(crate) const X: &str = "/api/x";'
  source_check
  [ "$status" -eq 0 ]
}

@test "ROUTES: .route( and Router::new() outside the composition files fail; a test file is free" {
  rs src/routes/things.rs 'fn r() -> Router { Router::new().route(paths::X, get(h)) }'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[ROUTES] Router::new( outside src/routes/mod.rs and src/lib.rs"* ]] || false
  [[ "$stderr" == *"[ROUTES] .route( outside src/routes/mod.rs and src/lib.rs"* ]] || false
  rm "$REPO/src/routes/things.rs"
  rs src/routes/mod.rs 'fn r() -> OpenApiRouter { OpenApiRouter::new().routes(routes!(h)) }'
  rs src/platform/middleware_tests.rs 'fn t() { Router::new().route("/ok", get(h)); }'
  source_check
  [ "$status" -eq 0 ]
}

@test "ROUTES: a string or comment that mentions a route is not one" {
  rs src/things/service.rs '// see "/api/x" and .route( in the docs' 'const S: &str = "Router::new().route(";'
  source_check
  [ "$status" -eq 0 ]
}

# ── LAYERS ──────────────────────────────────────────────────────────────────────────────────────

@test "LAYERS: sqlx in src/routes/ fails" {
  rs src/routes/things.rs 'use sqlx::PgPool;'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/routes/things.rs:1: [LAYERS] sqlx in src/routes/"* ]] || false
}

@test "LAYERS: axum in a domain fails; utoipa and sqlx there pass" {
  rs src/things/service.rs 'use axum::http::StatusCode;'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/things/service.rs:1: [LAYERS] axum in a domain"* ]] || false
  rs src/things/service.rs 'use sqlx::PgPool;' '#[derive(utoipa::ToSchema)] struct T;'
  source_check
  [ "$status" -eq 0 ]
}

@test "LAYERS: the platform naming a domain fails" {
  mkdir -p "$REPO/src/things"
  rs src/platform/db.rs 'use crate::things::model::Thing;'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[LAYERS] crate::things in src/platform/"* ]] || false
}

@test "LAYERS: a transaction outside a repo.rs fails, inside one passes" {
  rs src/things/service.rs 'async fn f(p: &P) { let tx = p.begin().await; }'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[LAYERS] a transaction opens only in a repo.rs"* ]] || false
  mv "$REPO/src/things/service.rs" "$REPO/src/things/repo.rs"
  source_check
  [ "$status" -eq 0 ]
}

# ── SQL ─────────────────────────────────────────────────────────────────────────────────────────

@test "SQL: SELECT * fails" {
  rs src/things/repo.rs 'const Q: &str = "select * from things where id = $1";'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/things/repo.rs:1: [SQL] SELECT *"* ]] || false
}

@test "SQL: a list query without LIMIT fails; with LIMIT or = ANY it passes" {
  rs src/things/repo.rs 'async fn f(p: &P) { sqlx::query_as!(T, "SELECT id, name FROM things ORDER BY id").fetch_all(p).await; }'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[SQL] a list query without LIMIT"* ]] || false
  rs src/things/repo.rs 'async fn f(p: &P) { sqlx::query_as!(T, "SELECT id, name FROM things WHERE id > $1 ORDER BY id LIMIT $2").fetch_all(p).await; }' \
    'async fn g(p: &P) { sqlx::query_as!(T, "SELECT id FROM things WHERE id = ANY($1)").fetch_all(p).await; }' \
    'async fn h(p: &P) { sqlx::query_as!(T, "SELECT id FROM things WHERE id = $1").fetch_one(p).await; }'
  source_check
  [ "$status" -eq 0 ]
}

@test "SQL: AssertSqlSafe( needs its sql-safe reason" {
  rs src/things/repo.rs 'fn q(s: String) { sqlx::query(AssertSqlSafe(s)); }'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[SQL] AssertSqlSafe( needs a \`// sql-safe: <reason>\` comment"* ]] || false
  rs src/things/repo.rs 'fn q(s: String) {' '    // sql-safe: the column name comes from a closed enum' '    sqlx::query(AssertSqlSafe(s));' '}'
  source_check
  [ "$status" -eq 0 ]
}

# ── ALLOW ───────────────────────────────────────────────────────────────────────────────────────

@test "ALLOW: #![allow( fails anywhere, tests included; #[expect] with a reason passes" {
  rs tests/api/main.rs '#![allow(clippy::unwrap_used, reason = "experiment")]'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"tests/api/main.rs:1: [ALLOW] #![allow( switches lints off"* ]] || false
  rs tests/api/main.rs '#![cfg(test)]' '#[expect(clippy::too_many_lines, reason = "a table of cases")]' 'fn t() {}'
  source_check
  [ "$status" -eq 0 ]
}

@test "ALLOW: ErrorCode deriving or implementing Deserialize fails" {
  rs src/platform/error.rs '#[derive(Debug, Serialize, Deserialize)]' 'pub(crate) enum ErrorCode { A }'
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/platform/error.rs:2: [ALLOW] ErrorCode derives Deserialize"* ]] || false
  rs src/platform/error.rs '#[derive(Debug, Serialize)]' 'pub(crate) enum ErrorCode { A }' \
    "impl<'de> serde::Deserialize<'de> for ErrorCode {}"
  source_check
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"[ALLOW] ErrorCode implements Deserialize"* ]] || false
  rs src/platform/error.rs '#[derive(Debug, Serialize)]' 'pub(crate) enum ErrorCode { A }'
  source_check
  [ "$status" -eq 0 ]
}

@test "rust-source passes the seeded skeleton as setup installs it, with and without the payload code" {
  cp -R "$TPL/src" "$TPL/tests" "$REPO/"
  rm -rf "$REPO/src/payload" "$REPO"/src/routes/payload*.rs
  commit_all skeleton
  source_check
  [ "$status" -eq 0 ]
  [[ "$output" == *"rust-source: 21 file(s); LINES HANDLERS ROUTES LAYERS SQL ALLOW clean"* ]] || false
  # payload-encryption=yes: 29 more files; the @generated registry is not checked.
  cp -R "$TPL/src" "$REPO/"
  commit_all payload
  source_check
  [ "$status" -eq 0 ]
  [[ "$output" == *"rust-source: 50 file(s); LINES HANDLERS ROUTES LAYERS SQL ALLOW clean"* ]] || false
}

# ── rustfmt.sh ──────────────────────────────────────────────────────────────────────────────────

@test "rustfmt.sh: an unstable option fails although cargo fmt exits 0" {
  install scripts/check/rustfmt.sh
  stub cargo "echo \"Warning: can't set \\\`imports_granularity = Crate\\\`, unstable features are only available in nightly channel.\" >&2; exit 0"
  run --separate-stderr bash "$REPO/scripts/check/rustfmt.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"rustfmt.toml sets an option stable rustfmt ignores"* ]] || false
}

@test "rustfmt.sh: a formatted crate passes, an unformatted one fails" {
  install scripts/check/rustfmt.sh
  stub cargo 'exit 0'
  run -0 --separate-stderr bash "$REPO/scripts/check/rustfmt.sh"
  [[ "$output" == *"rustfmt: every file formatted"* ]] || false
  stub cargo 'echo "Diff in /work/src/lib.rs:1:"; exit 1'
  run --separate-stderr bash "$REPO/scripts/check/rustfmt.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"run cargo fmt"* ]] || false
}

# ── migrations.sh ───────────────────────────────────────────────────────────────────────────────

@test "migrations.sh: no migrations/ folder passes and says so" {
  install scripts/check/migrations.sh
  run -0 --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [[ "$output" == *"no migrations/ here, so nothing to check"* ]] || false
}

@test "migrations.sh: sqlx names, a leading marker and a lone concurrent index pass" {
  install scripts/check/migrations.sh
  mkdir -p "$REPO/migrations"
  printf 'CREATE TABLE things (id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY);\n' >"$REPO/migrations/20261011000000_things.sql"
  printf -- '-- no-transaction\n-- squawk-disable-assume-in-transaction\nCREATE INDEX CONCURRENTLY things_id ON things (id);\n' \
    >"$REPO/migrations/20261011000001_things_index.sql"
  run -0 --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [[ "$output" == *"2 file(s) in migrations/"* ]] || false
}

@test "migrations.sh: -- no-transaction after a space, a stray name and a CIC in a transaction fail" {
  install scripts/check/migrations.sh
  mkdir -p "$REPO/migrations"
  printf ' -- no-transaction\nCREATE INDEX CONCURRENTLY a ON t (x);\n' >"$REPO/migrations/20261011000000_late_marker.sql"
  printf 'select 1;\n' >"$REPO/migrations/._20261011000001_copy.sql"
  printf -- '-- no-transaction\nCREATE INDEX CONCURRENTLY b ON t (x);\nCREATE INDEX CONCURRENTLY c ON t (y);\n' \
    >"$REPO/migrations/20261011000002_two.sql"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"20261011000000_late_marker.sql: -- no-transaction counts only as the file's first bytes"* ]] || false
  [[ "$stderr" == *"20261011000000_late_marker.sql: CONCURRENTLY cannot run in a transaction"* ]] || false
  [[ "$stderr" == *"._20261011000001_copy.sql: not <14-digit version>_<name>.sql"* ]] || false
  [[ "$stderr" == *"20261011000002_two.sql: a -- no-transaction file holds its one CONCURRENTLY statement"* ]] || false
}

@test "migrations.sh --base: a version below the base's highest and an edited base file fail" {
  install scripts/check/migrations.sh
  mkdir -p "$REPO/migrations"
  printf 'CREATE TABLE a (id int);\n' >"$REPO/migrations/20261011000000_a.sql"
  printf 'CREATE TABLE b (id int);\n' >"$REPO/migrations/20261012000000_b.sql"
  commit_all base
  git -C "$REPO" checkout -q -b work
  printf 'CREATE TABLE c (id int);\n' >"$REPO/migrations/20261013000000_c.sql"
  commit_all newer
  run -0 --separate-stderr bash "$REPO/scripts/check/migrations.sh" --base main
  [[ "$output" == *"none on main changed"* ]] || false
  printf 'CREATE TABLE old (id int);\n' >"$REPO/migrations/20261010000000_old.sql"
  printf -- '-- changed\n' >>"$REPO/migrations/20261011000000_a.sql"
  commit_all "older and edited"
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh" --base main
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"20261010000000_old.sql: version 20261010000000 is not above 20261012000000"* ]] || false
  [[ "$stderr" == *"migrations/20261011000000_a.sql: on main already"* ]] || false
  [[ "$stderr" != *"20261013000000_c.sql"* ]] || false
}

@test "migrations.sh --base: a deleted base file fails, an unknown base is a usage error" {
  install scripts/check/migrations.sh
  mkdir -p "$REPO/migrations"
  printf 'CREATE TABLE a (id int);\n' >"$REPO/migrations/20261011000000_a.sql"
  commit_all base
  git -C "$REPO" rm -q "$REPO/migrations/20261011000000_a.sql"
  mkdir -p "$REPO/migrations"
  printf 'CREATE TABLE b (id int);\n' >"$REPO/migrations/20261012000000_b.sql"
  commit_all gone
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh" --base HEAD~1
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"20261011000000_a.sql: deleted"* ]] || false
  run --separate-stderr bash "$REPO/scripts/check/migrations.sh" --base no-such-branch
  [ "$status" -eq 2 ]
}

# ── cargo-policy.sh ─────────────────────────────────────────────────────────────────────────────

policy_repo() {
  install scripts/check/cargo-policy.sh scripts/check/gates.list .cargo/config.toml clippy.toml rust-toolchain.toml
  cp "$TPL/Cargo.toml.starter" "$REPO/Cargo.toml"
  printf '# lock\n' >"$REPO/Cargo.lock"
  commit_all setup
}

@test "cargo-policy.sh: the seeded config, toolchain, lockfile and starter pass" {
  policy_repo
  run -0 --separate-stderr bash "$REPO/scripts/check/cargo-policy.sh"
  [[ "$output" == *"as the rules ask"* ]] || false
}

@test "cargo-policy.sh: a lost SQLX_OFFLINE, a [source] table and panic = abort fail" {
  policy_repo
  printf '[build]\nwarnings = "deny"\n\n[source.crates-io]\nreplace-with = "mirror"\n' >"$REPO/.cargo/config.toml"
  printf '\n[profile.dev]\npanic = "abort"\n' >>"$REPO/Cargo.toml"
  run --separate-stderr bash "$REPO/scripts/check/cargo-policy.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *'[env] must set SQLX_OFFLINE = "true"'* ]] || false
  [[ "$stderr" == *".cargo/config.toml:4: no [source], [registries], [registry] or [net] table here"* ]] || false
  [[ "$stderr" == *'Cargo.toml: panic = "abort" ends the process'* ]] || false
}

@test "cargo-policy.sh: a cargo call without --locked, a floating toolchain and an untracked lock fail" {
  policy_repo
  printf 'code\tcargo test --all-targets\n' >>"$REPO/scripts/check/gates.list"
  printf '[toolchain]\nchannel = "stable"\n' >"$REPO/rust-toolchain.toml"
  git -C "$REPO" rm -q --cached Cargo.lock
  run --separate-stderr bash "$REPO/scripts/check/cargo-policy.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"scripts/check/gates.list: line"*"runs cargo without --locked: code"* ]] || false
  [[ "$stderr" == *'channel is "stable", not an exact release'* ]] || false
  [[ "$stderr" == *"Cargo.lock is not tracked"* ]] || false
}

@test "cargo-policy.sh: rust-version must name the pinned toolchain" {
  policy_repo
  sed 's/^rust-version = "1.99"/rust-version = "1.90"/' "$REPO/Cargo.toml" >"$REPO/c" && mv "$REPO/c" "$REPO/Cargo.toml"
  run --separate-stderr bash "$REPO/scripts/check/cargo-policy.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"rust-version is 1.90 but rust-toolchain.toml pins 1.99.0"* ]] || false
}

# ── coverage.sh and pooler.sh ───────────────────────────────────────────────────────────────────

coverage_repo() {
  install scripts/check/coverage.sh scripts/check/coverage-per-file.mjs scripts/check/coverage-exempt.txt
}

# lcov_stub <lines hit> <lines found>: a cargo that writes one lcov record where llvm-cov would.
lcov_stub() {
  stub cargo "printf '%s\n' \"\$*\" >\"$BATS_TEST_TMPDIR/cargo-args\"; mkdir -p coverage; printf 'SF:src/lib.rs\nFNF:1\nFNH:1\nLF:$2\nLH:$1\nend_of_record\n' >coverage/lcov.info"
}

@test "coverage.sh: without DATABASE_URL it fails before running anything" {
  coverage_repo
  lcov_stub 4 4
  run --separate-stderr bash "$REPO/scripts/check/coverage.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"DATABASE_URL is not set"* ]] || false
  [ ! -e "$BATS_TEST_TMPDIR/cargo-args" ]
}

@test "coverage.sh: every file at 100% passes, and the exemptions reach llvm-cov" {
  coverage_repo
  lcov_stub 4 4
  DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres run -0 --separate-stderr bash "$REPO/scripts/check/coverage.sh"
  [[ "$output" == *"1 file(s), each at 100% (lines, functions)"* ]] || false
  run cat "$BATS_TEST_TMPDIR/cargo-args"
  [[ "$output" == "llvm-cov nextest --locked --ignore-filename-regex (^|/)(src/main\.rs|src/bin/.*)\$ --lcov --output-path coverage/lcov.info" ]] || false
}

@test "coverage.sh: a file below 100% fails and is named" {
  coverage_repo
  lcov_stub 3 4
  DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres run --separate-stderr bash "$REPO/scripts/check/coverage.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"src/lib.rs: lines 3/4, functions 1/1"* ]] || false
}

@test "pooler.sh: needs TEST_POOLER_DATABASE_URL, then runs only the ignored pooler tests" {
  install scripts/check/pooler.sh
  stub cargo "printf '%s\n' \"\$*\" >\"$BATS_TEST_TMPDIR/cargo-args\""
  run --separate-stderr bash "$REPO/scripts/check/pooler.sh"
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"TEST_POOLER_DATABASE_URL is not set"* ]] || false
  TEST_POOLER_DATABASE_URL=postgres://app_rw@127.0.0.1:6432/app_test run -0 bash "$REPO/scripts/check/pooler.sh"
  run cat "$BATS_TEST_TMPDIR/cargo-args"
  [ "$output" = "llvm-cov nextest --locked --no-report --run-ignored only --test pooler" ]
}

@test "coverage.sh and pooler.sh switch rustup's downloads off themselves (ci-env.sh passes no RUSTUP_*)" {
  install scripts/check/coverage.sh scripts/check/pooler.sh
  grep -qx 'export RUSTUP_AUTO_INSTALL=0' "$REPO/scripts/check/coverage.sh"
  grep -qx 'export RUSTUP_AUTO_INSTALL=0' "$REPO/scripts/check/pooler.sh"
}

# ── coverage-policy.mjs (the shared copy, on this stack's files) ───────────────────────────────

@test "coverage-policy: the seeded coverage.sh, gates.list and exemptions pass; an open category fails" {
  install scripts/check/coverage-policy.mjs scripts/check/coverage.sh scripts/check/coverage-exempt.txt \
    scripts/check/gates.list
  cd "$REPO"
  run -0 --separate-stderr node scripts/check/coverage-policy.mjs
  [[ "$output" == *"every exemption explained"* ]] || false
  printf 'src/platform/db.rs  # hard to test\n' >>scripts/check/coverage-exempt.txt
  run --separate-stderr node scripts/check/coverage-policy.mjs
  [ "$status" -eq 1 ]
  [[ "$stderr" == *"'src/platform/db.rs' is not a closed category"* ]] || false
}
