<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest (AGENTS.md Rule 25). Declare the data the app collects and, for every
  required-reason API category the code uses, the reasons from Apple's list. App Store Connect
  refuses an upload that uses such an API without its reason; scripts/check/privacy-manifest.sh
  finds the uses before that. Setup created this file once; it is yours now.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
