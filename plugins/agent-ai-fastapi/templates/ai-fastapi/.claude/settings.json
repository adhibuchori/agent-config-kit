{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(uv run vulture:*)",
      "Bash(uv run deptry:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv sync:*)"
    ],
    "ask": [
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Edit(SSOT.md)",
      "Edit(AGENTS.md)"
    ]
  }
}
