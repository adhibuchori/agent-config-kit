{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem; its code names it, and its type is the base below plus that code."
      }
    },
    "schemas": {
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "The schema rule the field broke, for example required or minLength.",
            "type": "string"
          },
          "pointer": {
            "description": "A JSON pointer into the body, or /\u003cin\u003e/\u003cname\u003e for a parameter.",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "code"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "enum": [
              "INTERNAL",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "MALFORMED_BODY",
              "BODY_TOO_LARGE",
              "VALIDATION_FAILED"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "requestId": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "example": "https://example.invalid/problems/NOT_FOUND",
            "format": "uri",
            "type": "string",
            "x-problem-type-base": "https://example.invalid/problems/"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Service API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The process is up."
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Report that the process serves requests"
      }
    }
  }
}
