# The variables the tests get in CI, and locally through scripts/check/ci-env.sh: dummy values only,
# never a real secret. The quality gate loads this file (its env-file input). The addresses name a
# throwaway PostgreSQL 18 with db/roles.sql applied and trust authentication, so they carry no
# password: the migrator (the tests migrate app_test with it first), the service's own role, and
# the service's role through PgBouncer (6432, when the gate runs pgbouncer-tests).
TEST_MIGRATIONS_URL=postgres://app_owner@127.0.0.1:5432/app_test?sslmode=disable
TEST_DATABASE_URL=postgres://app_rw@127.0.0.1:5432/app_test?sslmode=disable
TEST_POOLER_DATABASE_URL=postgres://app_rw@127.0.0.1:6432/app_test?sslmode=disable
