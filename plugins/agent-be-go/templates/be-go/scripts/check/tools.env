# The tool versions outside go.mod that the gates and the quality gate pin. golangci-lint is the
# one Go tool not run through `go tool`: its own docs advise the release binary. scripts/check/lint.sh
# refuses another version; the quality gate installs this one and checks its sha256. Move the pin
# together with go.mod's go line: golangci-lint refuses code newer than the Go it was built with.
GOLANGCI_LINT_VERSION=2.14.0
# squawk, the migration linter: almost every release turns a rule on, so it moves on purpose.
SQUAWK_VERSION=2.68.0
