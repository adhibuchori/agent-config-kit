# This repo's gates: `bash scripts/check/gates.sh` runs them, and so does .githooks/pre-commit.
# <kinds><TAB><command>. Kinds pick the gates a commit needs from what it stages; see gates.sh.
# No package.json here, so the format check is golangci-lint's own instead of @format. Each Go tool
# is the version go.mod's `tool` lines pin, run through `go tool`; golangci-lint is the release
# scripts/check/tools.env pins. The tests run through scripts/check/ci-env.sh: CI's variables
# (.env.ci.example), nothing from your shell, and a real PostgreSQL with db/roles.sql applied.
# scripts/check/pooler.sh is not listed: it needs a transaction pooler, which the quality gate
# starts when asked (pgbouncer-tests).
all	golangci-lint fmt --diff ./...
all	bash scripts/check/secrets.sh
code	bash scripts/check/lint.sh
code	go build ./...
code	go mod tidy -diff
code	bash scripts/check/generated.sh
code	bash scripts/check/migrations.sh
code	bash scripts/check/endpoints.sh
# Optional module, one setup question (payload-encryption). A repo without payload.config.json has
# not adopted the contract, and setup installed no payload-registry.mjs: this line then passes.
code	[ ! -f payload.config.json ] || node scripts/check/payload-registry.mjs
code	node scripts/check/folder-shape.mjs
code	node scripts/check/coverage-policy.mjs
code	bash scripts/check/ci-env.sh bash scripts/check/coverage.sh
all	bash scripts/check/ai-config.sh
commands,hooks	bash scripts/check/skills.sh --staged
