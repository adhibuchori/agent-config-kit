{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(**)"
    ],
    "ask": [
      "mcp__db-prod__execute_sql",
      "Edit(.claude/agent-config.json)",
      "Edit(.claude/agent-config-kit.lock)",
      "Edit(scripts/ops/unlock.sh)",
      "Edit(scripts/env/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin prod:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Edit(.env*)",
      "Edit(!.env*.example)",
      "Edit(.claude/state/**)",
      "Read(.env*)",
      "Read(!.env*.example)",
      "Read(.claude/state/env-backups/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "bash scripts/env/show.sh*",
      "bash scripts/env/set.sh*",
      "./scripts/env/show.sh*",
      "./scripts/env/set.sh*",
      "scripts/env/show.sh*",
      "scripts/env/set.sh*"
    ],
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        ".env-*",
        ".env_*",
        ".envrc",
        "./**/.env",
        "./**/.env.*",
        "./**/.env-*",
        "./**/.env_*",
        "./**/.envrc",
        ".claude/state/env-backups",
        ".claude/state/env-backups/**"
      ],
      "allowRead": [
        ".env.example",
        ".env.*.example",
        ".env-*.example",
        ".env_*.example",
        "./**/.env.example",
        "./**/.env.*.example",
        "./**/.env-*.example",
        "./**/.env_*.example"
      ],
      "denyWrite": [
        ".claude/state/unlock",
        ".claude/state/unlock/**"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "agent-config-kit": {
      "source": {
        "source": "github",
        "repo": "adhibuchori/agent-config-kit"
      }
    }
  },
  "enabledPlugins": {
    "agent-core@agent-config-kit": true
  }
}
