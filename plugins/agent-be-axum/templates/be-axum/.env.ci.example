# The variables the tests get in CI, and locally through scripts/check/ci-env.sh: dummy values
# only, never a real secret. The quality gate loads this file (its env-file input). Its PostgreSQL
# 18 trusts local connections, so no URL here carries a password. DATABASE_URL is the
# #[sqlx::test] tier: it creates a database per test, so it connects as the server's superuser.
# TEST_POOLER_DATABASE_URL is PgBouncer in front of the same server, as the service's own role
# (app_rw) on the database db/roles.sql creates (app_test), so its role settings are the ones
# read; only scripts/check/pooler.sh reads it.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable
TEST_POOLER_DATABASE_URL=postgres://app_rw@127.0.0.1:6432/app_test?sslmode=disable
