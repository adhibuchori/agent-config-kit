# The build context holds only what the image builds from. Anything else sent here can end up in a
# layer: a Dockerfile's `COPY . .` copies it whether or not the image needs it.

# Secrets: every env file, the templates too (the image reads its env from the platform at runtime).
.env*
.envrc

# The agent layer and its local state (.claude/state holds the unlock files and .env backups).
.claude/
.agent/
.agents/
.serena/
_workflow-source/
.mcp.json
AGENTS.md
CLAUDE.md
SSOT.md
.skillspector/
.skillspector-baseline.yaml
promote-deploy-logs/

# Version control, CI and local tooling.
.git/
.github/
.husky/
node_modules/
coverage/
dist/
*.log
.DS_Store
