# The variables the unit tests get in CI, and locally through scripts/check/ci-env.sh: dummy values
# only, never a real secret. The pull-request quality gate loads this file (its env-file input), and
# src/test/preload.ts replaces every client, so no unit test dials these. List the keys src/env.ts
# validates at import; a line of its own per KEY=VALUE, # for comments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379
