# Copy to .env.local for local builds, and set the same names in the host's build environment.
# Only NEXT_PUBLIC_ values reach the browser, and they are compiled into every page: never put a
# secret in one. A form endpoint's secrets live where that endpoint runs, not here.

# The production origin, without a trailing slash. metadataBase, canonical URLs, the sitemap and
# the checks in scripts/check/ read it.
NEXT_PUBLIC_SITE_URL=https://www.example.com
