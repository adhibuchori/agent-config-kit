{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "ignorePatterns": ["node_modules/", ".next/", "content/", "scripts/", "*.md"]
}
