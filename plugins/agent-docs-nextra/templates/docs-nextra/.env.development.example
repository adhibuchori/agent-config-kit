# Development environment template for this docs site. Committed; never put a real value here.
#
# The site itself reads no environment variables: only `docs:generate` and `changelog:generate`
# do. `bun run env:init` copies this file to .env.development (gitignored), and
# `scripts/next/env.ts check` requires every key below that has a non-empty value.

# Token the changelog generator uses to read the GitHub API.
GITHUB_TOKEN=PLACEHOLDER__GITHUB_TOKEN

# Optional. A separate token for reading the application repository; falls back to GITHUB_TOKEN.
APP_REPO_TOKEN=

# Optional. The application repository this site documents, as <github-org>/<app-repo>.
APP_REPO=

# Optional. This docs repository, as <github-org>/<docs-repo>.
DOCS_REPO=

# Optional. How many days of history the changelog covers.
LOOKBACK_DAYS=

# Optional. A local checkout of the application repository for docs:generate to read.
APP_SOURCE_ROOT=
